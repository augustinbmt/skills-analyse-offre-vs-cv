#!/usr/bin/env python3
"""test-detecteur — vérifie reperer-texte-cache.py sur les CV de test, dans tous ses modes.

Pour chaque cas : le code de sortie, les mots témoins qui DOIVENT être trouvés (pièges
cachés) et ceux qui ne doivent PAS l'être (injections visibles, que le détecteur n'a pas
à signaler : c'est le rôle de la lecture). Les CV propres ne doivent rien déclencher.

Modes testés :
  - PDF, méthode OCR (pdftoppm + tesseract + pypdf) ;
  - PDF, méthode de secours (OCR retiré du PATH) ;
  - DOCX (bibliothèque standard seulement).

Usage : ./bin/test-detecteur   (depuis n'importe où)
Nécessite : pypdf ; pour le mode OCR : poppler-utils et tesseract (fra).
En CI (variable CI définie), l'absence de l'OCR est une erreur ; en local, ces cas sont sautés.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

RACINE = Path(__file__).resolve().parent.parent
SCRIPT = RACINE / "plugins/carriere/skills/analyse-offre-vs-cv/scripts/reperer-texte-cache.py"
FIX = RACINE / "plugins/carriere/evals/fixtures"

VISIBLES = {"ROUGE", "ORANGE"}
PIEGES_PDF = {"VIOLET", "JAUNE", "VERT", "BLEU", "CYAN", "BEIGE", "OR", "BRUN"}
PIEGES_DOCX = {"VIOLET", "SABLE", "JAUNE", "GRIS", "TURQUOISE", "CORAIL", "INDIGO", "OLIVE", "MAUVE", "NOIR", "ROSE"}

# (libellé, fichier, mode, codes acceptés, témoins attendus, témoins interdits)
CAS = [
    ("PDF propre, OCR", "cv-propre.pdf", "ocr", {0}, set(), set()),
    ("PDF piégé, OCR", "cv-piege.pdf", "ocr", {1}, PIEGES_PDF, VISIBLES),
    ("PDF propre, secours", "cv-propre.pdf", "secours", {2}, set(), set()),
    ("PDF piégé, secours", "cv-piege.pdf", "secours", {1}, PIEGES_PDF - {"BRUN"}, VISIBLES),
    ("DOCX propre", "cv-propre.docx", "normal", {0}, set(), set()),
    ("DOCX piégé", "cv-piege.docx", "normal", {1}, PIEGES_DOCX, VISIBLES),
]


def env_sans_ocr(dossier):
    """PATH ne contenant que python3, pdftotext et pdfinfo : ni pdftoppm ni tesseract."""
    bin_ = Path(dossier) / "bin"
    bin_.mkdir()
    for outil in ("pdftotext", "pdfinfo"):
        chemin = shutil.which(outil)
        if chemin:
            os.symlink(chemin, bin_ / outil)
    os.symlink(sys.executable, bin_ / "python3")
    env = dict(os.environ)
    env["PATH"] = str(bin_)
    return env


def main():
    ocr_dispo = all(shutil.which(o) for o in ("pdftoppm", "tesseract"))
    en_ci = bool(os.environ.get("CI"))
    echecs = sautes = 0
    with tempfile.TemporaryDirectory() as tmp:
        env_secours = env_sans_ocr(tmp)
        for libelle, fichier, mode, codes, attendus, interdits in CAS:
            if mode == "ocr" and not ocr_dispo:
                if en_ci:
                    print(f"ÉCHEC {libelle:22} pdftoppm ou tesseract absent en CI")
                    echecs += 1
                else:
                    print(f"SAUTÉ {libelle:22} (installer poppler et tesseract pour ce cas)")
                    sautes += 1
                continue
            env = env_secours if mode == "secours" else None
            r = subprocess.run([sys.executable, str(SCRIPT), str(FIX / fichier)],
                               capture_output=True, text=True, env=env, timeout=600)
            signalements = [l for l in r.stdout.splitlines() if l.startswith("[") and not l.startswith("[info]")]
            trouves = set(re.findall(r"CANARI-([A-Z]+)", "\n".join(signalements)))
            manquants = attendus - trouves
            en_trop = trouves & interdits
            faux_positifs = signalements if not attendus else []
            ok = r.returncode in codes and not manquants and not en_trop and not faux_positifs
            statut = "OK   " if ok else "ÉCHEC"
            detail = f"{len(attendus & trouves)}/{len(attendus)} pièges" if attendus else f"{len(signalements)} signalement(s)"
            print(f"{statut} {libelle:22} code {r.returncode} ; {detail}")
            if r.returncode not in codes:
                print(f"      code attendu : {sorted(codes)}")
            if manquants:
                print(f"      pièges non trouvés : {sorted(manquants)}")
            if en_trop:
                print(f"      injections visibles signalées comme cachées : {sorted(en_trop)}")
            for fp in faux_positifs:
                print(f"      faux positif : {fp[:160]}")
            if r.returncode == 2 and not ok:
                print("      " + r.stdout.strip().replace("\n", "\n      "))
            echecs += not ok
    bilan = "SUCCÈS" if not echecs else f"{echecs} ÉCHEC(S)"
    print(bilan + (f" ({sautes} cas sautés)" if sautes else ""))
    return 1 if echecs else 0


if __name__ == "__main__":
    sys.exit(main())
